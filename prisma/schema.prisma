generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OWNER
  TRAINER
  GUEST
}

enum Sex {
  MALE
  FEMALE
}

enum DogDocumentType {
  ICAD
  PEDIGREE
  PASSPORT
  VACCINATION
  MEDICAL
  COMPETITION
  OTHER
}
enum TrainingType {
  CYNODROME
  PVL
  BIKE
  SPRINT
  WALK
}

enum WeatherCondition {
  SUNNY
  CLOUDY
  RAINY
  NIGHT
}

enum TrainingReaction {
  EXCELLENT
  VERY_GOOD
  GOOD
  AVERAGE
  POOR
}

model User {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String     @unique
  phone        String?
  passwordHash String
  roles        UserRole[]

  ownedDogs   Dog[] @relation("DogOwner")
  trainedDogs Dog[] @relation("DogTrainers")

  clubLinks UserClub[]
  createdTrainings Training[] @relation("TrainingCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Club {
  id      String  @id @default(cuid())
  name    String
  city    String?
  country String?

  userLinks UserClub[]
  dogs      Dog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dog {
  id               String    @id @default(cuid())
  name             String
  breed            String
  category         String?
  coat             String?
  distinctiveMark  String?
  sex              Sex
  birthDate        DateTime?
  weight           Float?
  icad             String?

  ownerId String
  owner   User   @relation("DogOwner", fields: [ownerId], references: [id])

  trainers User[] @relation("DogTrainers")
  trainingResults TrainingResult[]
  clubId String?
  club   Club? @relation(fields: [clubId], references: [id])

  documents DogDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DogDocument {
  id String @id @default(cuid())

  dogId String
  dog   Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  type DogDocumentType

  originalName String
  storagePath  String
  mimeType     String
  size         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserClub {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  joinedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clubId])
}
model Training {
  id String @id @default(cuid())

  date DateTime

  location String
  terrain String

  type TrainingType

  distanceMeters Float

  weather WeatherCondition
  temperature Float?

  notes String?

  createdById String
  createdBy User @relation("TrainingCreator", fields: [createdById], references: [id])

  results TrainingResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingResult {
  id String @id @default(cuid())

  trainingId String
  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  dogId String
  dog Dog @relation(fields: [dogId], references: [id])

  durationSeconds Float

  motivation Int

  reaction TrainingReaction?

  observations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trainingId, dogId])
}

